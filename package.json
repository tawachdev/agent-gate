{
  "name": "agent-gate",
  "version": "0.1.0",
  "description": "Let AI agents read freely and make every write wait for a human. Signed, single-use, actor-bound confirmations for LLM tool calls.",
  "license": "MIT",
  "author": "Mohamed Taaouach",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tawachdev/agent-gate.git"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "tool-calling",
    "function-calling",
    "human-in-the-loop",
    "confirmation",
    "zod"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "example": "npm run build && node examples/basic.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "peerDependencies": {
    "zod": "^4.2.0"
  },
  "dependencies": {
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@google/genai": "2.31.0",
    "@types/node": "26.6.5",
    "openai": "7.45.0",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  }
}
